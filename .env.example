# ======================
# Core Configuration
# ======================
SESSION_SECRET=your-session-secret-here-generate-a-long-random-string
DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# ======================
# SMTP/Email Configuration
# ======================
SMTP_FROM=no-reply@yourstore.com
SMTP_HOST=smtp.yourprovider.com
SMTP_PASSWORD=your-smtp-password
SMTP_PORT=587
SMTP_USER=your-smtp-username
# This is the link to your store, used in emails when sending order confirmations, shipping updates, etc.
# Make sure to include the protocol (http:// or https://)
SMTP_STORE_LINK=https://yourstore.com

# ======================
# S3/File Storage
# ======================
S3_ACCESS_KEY_ID=your-s3-access-key
S3_BUCKET_NAME=your-bucket-name
S3_ENDPOINT=https://your-s3-endpoint.com
S3_REGION=us-east-1
S3_SECRET_ACCESS_KEY=your-s3-secret-key

# ======================
# Payment Processing - Stripe
# The provider must also be installed and connected to the checkout region.
# ======================
NEXT_PUBLIC_STRIPE_KEY=pk_test_your-stripe-public-key
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# ======================
# Payment Processing - PayPal
# The client ID is public; the client secret and webhook ID stay server-side.
# The provider must also be installed and connected to the checkout region.
# ======================
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id
# Set to "true" for sandbox/test mode, "false" for production
NEXT_PUBLIC_PAYPAL_SANDBOX=true

# ======================
# AI/OpenRouter Integration
# ======================
# OpenRouter API Key - Get yours at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key
# OpenRouter Model - Browse models at https://openrouter.ai/models
# Copy the model key (e.g., "openrouter/auto", "anthropic/claude-3.5-sonnet", etc.)
# Be weary of using free models in production, you could be sending customer data to 3rd parties
OPENROUTER_MODEL=openai/gpt-4o-mini

# ======================
# Regional Configuration
# ======================
NEXT_PUBLIC_DEFAULT_REGION=us

# ======================
# Branding Configuration
# ======================
# Set to 'true' to hide OpenFront branding/CTA in the storefront
HIDE_OPENFRONT_BRANDING=false

# ======================
# Marketplace Token Configuration
# ======================
# Secret key for signing marketplace tokens (mtok) - generate a secure random string
MARKETPLACE_TOKEN_SECRET=your-very-secure-marketplace-token-secret-here-at-least-32-chars